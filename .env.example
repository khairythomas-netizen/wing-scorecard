# --- Backend ---------------------------------------------------------------
# Leave both unset and the app runs on the seeded local store with demo auth,
# which is how the public GitHub Pages build currently works.
# Set both and it switches to Postgres + real accounts. The anon key is meant
# to be public; row-level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Providers -------------------------------------------------------------
# Both optional. Without them the app uses mock places/map adapters over
# seeded real coordinates.

# Google Places (New). Activates src/lib/places/googlePlacesProvider.ts, which
# also supplies licensed photos of restaurants that nobody has reviewed yet.
# Without it those swipe cards fall back to a designed placeholder.
# See "Restaurant photos" in README.md. Restrict the key by HTTP referrer:
# it ships in the bundle and in photo URLs, which is normal for Places on the
# web, but only safe with referrer restrictions applied.
VITE_GOOGLE_PLACES_KEY=

# Mapillary. Free, and the only restaurant-photo source that does not want a
# card on file. Gives street-level shots of the storefront for places nobody
# has reviewed yet. Token: mapillary.com/dashboard/developers
VITE_MAPILLARY_TOKEN=

# Mapbox GL. Activates src/lib/map/MapboxSurface.tsx (needs `npm i mapbox-gl`).
VITE_MAPBOX_TOKEN=
